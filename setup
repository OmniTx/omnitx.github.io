function Invoke-KVRT {
    $desktopPath = [Environment]::GetFolderPath("Desktop")
    $kvrtPath = Join-Path $desktopPath "KVRT.exe"

    if ($DryRun) {
        Write-Log "[DRYRUN] Would download KVRT to $kvrtPath" -Level INFO
        Write-Host "  [DRYRUN] Simulating KVRT download..." -ForegroundColor Yellow
        
        Write-Host "`nLaunch KVRT now? (Y/N): " -NoNewline -ForegroundColor Yellow
        while ($true) {
            $runKey = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
            if ($runKey -eq 'Y') {
                Write-Host "Y" -ForegroundColor Green
                Write-Log "[DRYRUN] Would launch KVRT" -Level INFO
                break
            }
            elseif ($runKey -eq 'N') {
                Write-Host "N" -ForegroundColor Cyan
                Write-Log "[DRYRUN] User chose not to launch KVRT." -Level INFO
                break
            }
        }
        return $true
    }

    $downloaded = Invoke-Failsafe -Name "Download KVRT" -Action {
        Invoke-WebRequest -Uri "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe" `
            -OutFile $kvrtPath -UseBasicParsing
        Write-Log "KVRT saved to $kvrtPath" -Level OK
    }

    if (-not $downloaded) { return $false }

    Write-Host "`nLaunch KVRT now? (Y/N): " -NoNewline -ForegroundColor Yellow
    while ($true) {
        $runKey = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        if ($runKey -eq 'Y') {
            Write-Host "Y" -ForegroundColor Green
            Invoke-Failsafe -Name "Launch KVRT" -Action { Start-Process $kvrtPath }
            break
        }
        elseif ($runKey -eq 'N') {
            Write-Host "N" -ForegroundColor Cyan
            Write-Log "User chose not to launch KVRT." -Level INFO
            break
        }
    }
}

#endregion Repair Tools

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Main Application Loop
# ═══════════════════════════════════════════════════════════════════════════════
#region Main

Write-Log ("=" * 60) -Level INFO
Write-Log "OMNITX Setup v$ScriptVersion — Session started." -Level INFO
Write-Log "Package Manager: $PackageManager" -Level INFO
if ($DryRun) { Write-Log "DRY RUN MODE ENABLED — No changes will be made" -Level WARN }
Write-Log ("=" * 60) -Level INFO

while ($true) {
    $mainMenuItems = @(
        [pscustomobject]@{ Display = "1. Install OMNITX Setup (Apps & Tools)"; Id = "Apps"; Selected = $false }
        [pscustomobject]@{ Display = "2. Fix & Repair Windows"; Id = "Fix"; Selected = $false }
        [pscustomobject]@{ Display = "3. Exit"; Id = "Exit"; Selected = $false }
    )

    $mainChoice = Show-Menu -Title "OMNITX Main Menu" -MenuItems $mainMenuItems -SingleSelect

    if ($mainChoice -eq "ESC" -or $mainChoice -eq "BACK") { break }

    $selectedMain = ($mainChoice | Where-Object { $_.Selected }).Id

    if ($selectedMain -eq "Exit") {
        Write-Log "User exited the script." -Level INFO
        Write-Host "`nExiting OMNITX Setup. Goodbye!" -ForegroundColor Green
        break
    }

    if ($selectedMain -eq "Apps") {
        Assert-PackageManager

        $successCount = 0
        $failCount = 0
        $skippedCount = 0
        $aborted = $false

        Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Cyan
        Write-Host "║          APP INSTALLER — One by One                      ║" -ForegroundColor Cyan
        Write-Host "║  Package Manager: $PackageManager" -ForegroundColor Yellow
        Write-Host "║  [Y] Install   [N] Skip   [ESC] Abort remaining          ║" -ForegroundColor Cyan
        Write-Host "╚══════════════════════════════════════════════════════════╝`n" -ForegroundColor Cyan

        for ($idx = 0; $idx -lt $AppCatalog.Count; $idx++) {
            $app = $AppCatalog[$idx]

            if ($aborted) { break }

            $num = $idx + 1
            $total = $AppCatalog.Count
            $tag = switch ($app.Type) {
                "VNC" { "  [VNC — will configure]" }
                "ZeroTier" { "  [Auto-join network]" }
                default { "" }
            }

            $packageId = if ($PackageManager -eq "Chocolatey") { $app.ChocoId } else { $app.WingetId }

            Write-Host ("─" * 60) -ForegroundColor DarkGray
            Write-Host "  [$num/$total]  $($app.Display)$tag" -ForegroundColor White
            Write-Host "          Package: $packageId ($PackageManager)" -ForegroundColor DarkGray
            Write-Host "  Install? [Y/N/ESC]: " -NoNewline -ForegroundColor Yellow

            $decision = $null
            while ($true) {
                $k = [System.Console]::ReadKey($true)
                if ($k.Key -eq 'Escape') {
                    Write-Host "ESC — Aborting remaining apps." -ForegroundColor Red
                    Write-Log "User pressed ESC at app $num/$total ($($app.Display)). Aborting remaining." -Level WARN
                    $aborted = $true
                    $decision = "SKIP"
                    break
                }
                $ch = $k.KeyChar.ToString().ToUpper()
                if ($ch -eq 'Y') {
                    Write-Host "Y" -ForegroundColor Green
                    $decision = "INSTALL"
                    break
                }
                elseif ($ch -eq 'N') {
                    Write-Host "N — Skipped" -ForegroundColor DarkGray
                    $decision = "SKIP"
                    break
                }
            }

            if ($decision -eq "SKIP") {
                $skippedCount++
                Write-Log "Skipped: $($app.Display)" -Level INFO
                continue
            }

            switch ($app.Type) {
                "Standard" {
                    $ok = Install-StandardApp -AppId $packageId -DisplayName $app.Display
                    if ($ok) { $successCount++ } else { $failCount++ }
                }
                "VNC" {
                    $ok = Install-TightVNC
                    if ($ok -eq $false) { $skippedCount++ }
                    else { $successCount++ }
                }
                "ZeroTier" {
                    $ok = Install-ZeroTier-AutoJoin
                    if ($ok) { $successCount++ } else { $failCount++ }
                }
            }

            Write-Host ""
        }

        if (-not $aborted) {
            Write-Host ("─" * 60) -ForegroundColor DarkGray
            Write-Host "`n  Install custom packages via $PackageManager? [Y/N]: " -NoNewline -ForegroundColor Magenta
            $doCustom = $false
            while ($true) {
                $ck = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
                if ($ck -eq 'Y') { Write-Host "Y`n" -ForegroundColor Green; $doCustom = $true; break }
                if ($ck -eq 'N') { Write-Host "N`n" -ForegroundColor DarkGray; break }
            }

            if ($doCustom) {
                Write-Host "--- Custom Application Installation ($PackageManager) ---`n" -ForegroundColor Cyan
                $installMore = $true
                while ($installMore) {
                    $promptText = if ($PackageManager -eq "Chocolatey") { "Enter the Chocolatey package ID (e.g., firefox)" } else { "Enter the winget package ID (e.g., Mozilla.Firefox)" }
                    $customApp = Read-Host $promptText
                    if (![string]::IsNullOrWhiteSpace($customApp)) {
                        $ok = Install-StandardApp -AppId $customApp -DisplayName $customApp
                        if ($ok) { $successCount++ } else { $failCount++ }
                    }
                    Write-Host "`nInstall another? (Y/N): " -NoNewline -ForegroundColor Yellow
                    while ($true) {
                        $ck2 = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
                        if ($ck2 -eq 'Y') { Write-Host "Y`n" -ForegroundColor Cyan; break }
                        if ($ck2 -eq 'N') { Write-Host "N`n" -ForegroundColor Cyan; $installMore = $false; break }
                    }
                }
            }
        }

        Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Cyan
        Write-Host "║                  INSTALLATION REPORT                     ║" -ForegroundColor Cyan
        Write-Host "╠══════════════════════════════════════════════════════════╣" -ForegroundColor Cyan
        Write-Host ("║  Package Manager : $PackageManager".PadRight(58) + "║") -ForegroundColor Yellow
        Write-Host ("║  Succeeded       : $successCount".PadRight(58) + "║") -ForegroundColor Green
        Write-Host ("║  Skipped         : $skippedCount".PadRight(58) + "║") -ForegroundColor DarkGray
        Write-Host ("║  Failed          : $failCount".PadRight(58) + "║") -ForegroundColor $(if ($failCount -gt 0) { "Red" } else { "Green" })
        Write-Host ("║  Log File        : $LogFile".PadRight(58) + "║") -ForegroundColor Yellow
        if ($DryRun) {
            Write-Host ("║  Mode            : DRY RUN (no changes made)".PadRight(58) + "║") -ForegroundColor Yellow
        }
        Write-Host "╚══════════════════════════════════════════════════════════╝`n" -ForegroundColor Cyan

        Write-Log "Installation complete. $successCount OK, $skippedCount skipped, $failCount failed." -Level $(if ($failCount -gt 0) { "WARN" } else { "OK" })

        Write-Host "Press any key to return to Main Menu..." -ForegroundColor Yellow
        $null = [System.Console]::ReadKey($true)
    }

    elseif ($selectedMain -eq "Fix") {
        $script:TempDnsAdapter = $null

        while ($true) {
            $fixItems = @(
                [pscustomobject]@{ Display = "Switch Package Manager (Winget ↔ Chocolatey)"; Id = "SWITCH_PM"; Selected = $false }
                [pscustomobject]@{ Display = "Repair/Install Winget + Dependencies"; Id = "WINGET_REPAIR"; Selected = $false }
                [pscustomobject]@{ Display = "Repair/Install Chocolatey"; Id = "CHOCO_REPAIR"; Selected = $false }
                [pscustomobject]@{ Display = "Temporarily apply Cloudflare DNS (1.1.1.1)"; Id = "CF_DNS"; Selected = $false }
                [pscustomobject]@{ Display = "SFC /Scannow (System File Checker)"; Id = "SFC"; Selected = $false }
                [pscustomobject]@{ Display = "DISM /RestoreHealth (Standard, No Proxy)"; Id = "DISM"; Selected = $false }
                [pscustomobject]@{ Display = "DISM /RestoreHealth (Custom Proxy)"; Id = "DISM_PROXY"; Selected = $false }
                [pscustomobject]@{ Display = "Run Massgrave Activation Script"; Id = "MASSGRAVE"; Selected = $false }
                [pscustomobject]@{ Display = "Run Chris Titus WinUtil (Tweaks & Debloat)"; Id = "WINUTIL"; Selected = $false }
                [pscustomobject]@{ Display = "Download & Run KVRT (Malware Scan)"; Id = "KVRT"; Selected = $false }
            )

            $fixChoice = Show-Menu -Title "Windows Repair & Security (Enter to run action)" -MenuItems $fixItems -SingleSelect

            if ($fixChoice -eq "ESC" -or $fixChoice -eq "BACK") {
                Restore-DNS
                break
            }

            $selectedAction = ($fixChoice | Where-Object { $_.Selected }).Id

            switch ($selectedAction) {
                "SWITCH_PM" { Switch-PackageManager }
                "WINGET_REPAIR" { Repair-WingetFull }
                "CHOCO_REPAIR" { Repair-ChocolateyFull }
                "CF_DNS" { Set-TemporaryCloudflareDNS }
                "SFC" { Invoke-SFC }
                "DISM" { Invoke-DISM }
                "DISM_PROXY" { Invoke-DISM-WithProxy }
                "MASSGRAVE" { Invoke-Massgrave }
                "WINUTIL" { Invoke-WinUtil }
                "KVRT" { Invoke-KVRT }
            }

            Write-Host "`nTask complete. Press any key to return to the Repair menu..." -ForegroundColor Yellow
            $null = [System.Console]::ReadKey($true)
        }
    }
}

Write-Log "OMNITX Setup session ended." -Level INFO
Write-Host "`nLog saved to: $LogFile`n" -ForegroundColor DarkGray

#endregion Main