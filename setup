<#
.SYNOPSIS
    OMNITX Setup Script - Automated Windows provisioning tool.

.DESCRIPTION
    One-command setup script for provisioning Windows machines in a home/lab
    environment. Designed to be invoked directly from the web:

        Set-ExecutionPolicy Bypass -Scope Process -Force
        Invoke-RestMethod -Uri https://omnitx.github.io/setup | Invoke-Expression

    Features
    --------
    * One-by-one app installation with Y/N/ESC per app
    * Winget-based installation with auto-fallback if package IDs change
    * TightVNC: server-only, no tray, no start menu, file transfer,
      RDP session, local input blocked, no-auth or password mode
    * ZeroTier auto-join to a pre-configured network
    * Windows repair toolkit (SFC, DISM, DNS, KVRT, Massgrave, WinUtil)
    * Custom winget package installation loop
    * Per-operation try/catch failsafe - one failure never kills the script
    * Timestamped log file on the Desktop for every session
    * DryRun mode for testing UI without installing anything

.NOTES
    Author  : OMNITX
    Updated : 2026-03-08
    License : MIT
    Version : 3.0.2

    CONFIGURATION
    -------------
    All user-editable values live in the "Configuration" region below.
    Change the ZeroTier network ID, app list, log path, etc. there.

    LOGGING
    -------
    Every action is logged to  %USERPROFILE%\Desktop\OMNITX_Setup_Log.txt
    with ISO-8601 timestamps and severity levels (INFO / WARN / ERROR / OK).

    ERROR HANDLING
    --------------
    Each discrete operation (app install, ZeroTier join, repair command, etc.)
    is wrapped in its own try/catch block. If something fails:
      1. The error is logged.
      2. A yellow warning is printed to the console.
      3. Execution continues with the next operation.
    The script will NEVER crash out because of a single failed step.
#>

#requires -Version 5.1

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Execution Policy & Admin Elevation
# ═══════════════════════════════════════════════════════════════════════════════
Set-ExecutionPolicy Bypass -Scope Process -Force

if (!([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Warning "Administrator permissions required. Prompting for elevation..."
    if ($PSCommandPath) {
        Start-Process PowerShell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`"" -Verb RunAs
    }
    else {
        # When run via Invoke-Expression from the web, re-fetch and re-run as admin
        $webCmd = "Set-ExecutionPolicy Bypass -Scope Process -Force; Invoke-RestMethod -Uri https://omnitx.github.io/setup | Invoke-Expression"
        Start-Process PowerShell -ArgumentList "-NoProfile -Command `"$webCmd`"" -Verb RunAs
    }
    exit
}

