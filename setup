<#
.SYNOPSIS
    OMNITX Setup Script — Automated Windows provisioning tool.

.DESCRIPTION
    One-command setup script for provisioning Windows machines in a home/lab
    environment. Designed to be invoked directly from the web:

        Set-ExecutionPolicy Bypass -Scope Process -Force
        Invoke-RestMethod -Uri https://omnitx.github.io/setup | Invoke-Expression

    Features
    --------
    • One-by-one app installation with Y/N/ESC per app
    • Dual package manager support: Winget OR Chocolatey
    • TightVNC: server-only, no tray, no start menu, file transfer,
      RDP session, local input blocked, no-auth or password mode
    • ZeroTier auto-join to a pre-configured network
    • Windows repair toolkit (SFC, DISM, DNS, KVRT, Massgrave, WinUtil, Winget/Choco Repair)
    • Custom package installation loop (supports both managers)
    • Per-operation try/catch failsafe — one failure never kills the script
    • Timestamped log file on the Desktop for every session
    • DryRun mode for testing UI without installing anything

.NOTES
    Author  : OMNITX
    Updated : 2026-03-08
    License : MIT

    CONFIGURATION
    ─────────────
    All user-editable values live in the "Configuration" region below.
    Change the ZeroTier network ID, app list, log path, package manager, etc. there.

    LOGGING
    ───────
    Every action is logged to  %USERPROFILE%\Desktop\OMNITX_Setup_Log.txt
    with ISO-8601 timestamps and severity levels (INFO / WARN / ERROR / OK).

    ERROR HANDLING
    ──────────────
    Each discrete operation (app install, ZeroTier join, repair command, etc.)
    is wrapped in its own try/catch block. If something fails:
      1. The error is logged.
      2. A yellow warning is printed to the console.
      3. Execution continues with the next operation.
    The script will NEVER crash out because of a single failed step.
#>

#requires -Version 5.1
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$PSDefaultParameterValues['Out-File:Encoding'] = 'utf8'

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Execution Policy & Admin Elevation
# ═══════════════════════════════════════════════════════════════════════════════
Set-ExecutionPolicy Bypass -Scope Process -Force

if (!([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Warning "Administrator permissions required. Prompting for elevation..."
    if ($PSCommandPath) {
        Start-Process PowerShell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`"" -Verb RunAs
    }
    else {
        # When run via Invoke-Expression from the web, re-fetch and re-run as admin
        $webCmd = "Set-ExecutionPolicy Bypass -Scope Process -Force; Invoke-RestMethod -Uri https://omnitx.github.io/setup | Invoke-Expression"
        Start-Process PowerShell -ArgumentList "-NoProfile -Command `"$webCmd`"" -Verb RunAs
    }
    exit
}

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Configuration  (edit these values to customize the script)
# ═══════════════════════════════════════════════════════════════════════════════
#region Configuration

# --- Script Version ---
$ScriptVersion = "3.2.1"

# --- DryRun Mode ---
# Set to $true to test the full UI without installing anything.
# All package manager commands are simulated. Menus, prompts, and logging work normally.
$DryRun = $false

# --- Package Manager Selection ---
# Set to "Winget" or "Chocolatey" to choose your preferred package manager.
# If the selected manager is not available, the script will attempt to install it.
# If installation fails, you can switch to the other manager in the Repair menu.
$PackageManager = "Winget"  # Options: "Winget", "Chocolatey"

# --- ZeroTier ---
$ZeroTierNetworkId = "17d709436c5d1c9e"                     # Network to auto-join

# --- Logging ---
$LogFile = Join-Path ([Environment]::GetFolderPath("Desktop")) "OMNITX_Setup_Log.txt"

# --- App Catalog ---
# Each entry: Display name (shown to user), package IDs for both managers, and a Type
# tag that controls special post-install behavior.
#
#   Type values:
#     Standard  – installed silently via package manager, no extra steps
#     VNC       – TightVNC with full configuration prompt
#     ZeroTier  – installed then auto-joined to $ZeroTierNetworkId
#
# Apps are presented ONE BY ONE. The user confirms each individually.
#
$AppCatalog = @(
    @{ Display = "7-Zip"; WingetId = "7zip.7zip"; ChocoId = "7zip"; Type = "Standard" }
    @{ Display = "WinRAR"; WingetId = "RARLab.WinRAR"; ChocoId = "winrar"; Type = "Standard" }
    @{ Display = "LocalSend"; WingetId = "localsend.localsend"; ChocoId = "localsend"; Type = "Standard" }
    @{ Display = "Everything (Alpha)"; WingetId = "voidtools.Everything.Alpha"; ChocoId = "everything"; Type = "Standard" }
    @{ Display = "Notepad++"; WingetId = "Notepad++.Notepad++"; ChocoId = "notepadplusplus"; Type = "Standard" }
    @{ Display = "PotPlayer"; WingetId = "Daum.PotPlayer"; ChocoId = "potplayer"; Type = "Standard" }
    @{ Display = "qBittorrent"; WingetId = "qBittorrent.qBittorrent"; ChocoId = "qbittorrent"; Type = "Standard" }
    @{ Display = "Cloudflare WARP"; WingetId = "Cloudflare.Warp"; ChocoId = "cloudflare-warp"; Type = "Standard" }
    @{ Display = "TightVNC"; WingetId = "TightVNC.TightVNC"; ChocoId = "tightvnc"; Type = "VNC" }
    @{ Display = "ZeroTier"; WingetId = "ZeroTier.ZeroTierOne"; ChocoId = "zerotier-one"; Type = "ZeroTier" }
)

#endregion Configuration

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Logging Subsystem
# ═══════════════════════════════════════════════════════════════════════════════
#region Logging

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet("INFO", "WARN", "ERROR", "OK")][string]$Level = "INFO"
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "[$timestamp] [$Level] $Message"

    # Append to log file (create if missing)
    try { $entry | Out-File -FilePath $LogFile -Append -Encoding UTF8 } catch { }

    # Console color map
    $colorMap = @{ INFO = "White"; WARN = "Yellow"; ERROR = "Red"; OK = "Green" }
    Write-Host $entry -ForegroundColor $colorMap[$Level]
}

#endregion Logging

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Utility Helpers
# ═══════════════════════════════════════════════════════════════════════════════
#region Helpers

function Invoke-Failsafe {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][scriptblock]$Action
    )
    try {
        Write-Log "START  ▸ $Name" -Level INFO
        & $Action
        Write-Log "DONE   ✓ $Name" -Level OK
        return $true
    }
    catch {
        Write-Log "FAILED ✗ $Name — $($_.Exception.Message)" -Level ERROR
        return $false
    }
}

function Show-Banner {
    param([string]$Color = "Cyan")

    $lines = @(
        "  @@@@@   @@@   @@@  @@@   @@  @@  @@@@@@@  @@   @@ "
        " @@   @@  @@@@ @@@@  @@@@  @@  @@    @@      @@ @@  "
        " @@   @@  @@ @@@ @@  @@ @@ @@  @@    @@       @@@   "
        " @@   @@  @@     @@  @@  @@@@  @@    @@      @@ @@  "
        "  @@@@@   @@     @@  @@   @@@  @@    @@     @@   @@ "
    )
    foreach ($l in $lines) { Write-Host $l -ForegroundColor $Color }
    Write-Host "`n  OMNITX Setup Script v$ScriptVersion" -ForegroundColor White
    Write-Host "  Package Manager: $PackageManager" -ForegroundColor Cyan
    Write-Host "  Running with Administrator privileges.`n" -ForegroundColor Green
    if ($DryRun) {
        Write-Host "  ██████  DRY RUN MODE — Nothing will be installed  ██████`n" -ForegroundColor Yellow
    }
}

function Show-Menu {
    param(
        [string]$Title,
        [array]$MenuItems,
        [switch]$SingleSelect
    )

    $cursor = 0
    [System.Console]::CursorVisible = $false
    Clear-Host

    $bannerColors = @("Cyan", "Magenta", "Yellow", "Green", "Red", "Blue", "White")
    $cIndex = 0
    $lastTime = Get-Date
    $needsRedraw = $true

    while ($true) {
        # Cycle banner color every second for visual flair
        $now = Get-Date
        if (($now - $lastTime).TotalMilliseconds -ge 1000) {
            $cIndex = ($cIndex + 1) % $bannerColors.Count
            $lastTime = $now
            $needsRedraw = $true
        }

        # Handle key presses
        if ([System.Console]::KeyAvailable) {
            $key = [System.Console]::ReadKey($true)

            switch ($key.Key) {
                'UpArrow' { if ($cursor -gt 0) { $cursor--; $needsRedraw = $true } }
                'DownArrow' { if ($cursor -lt ($MenuItems.Count - 1)) { $cursor++; $needsRedraw = $true } }
                'Spacebar' {
                    if (-not $SingleSelect) {
                        $MenuItems[$cursor].Selected = -not $MenuItems[$cursor].Selected
                        $needsRedraw = $true
                    }
                }
                'Escape' {
                    [System.Console]::CursorVisible = $true
                    Clear-Host; Show-Banner -Color "Cyan"
                    return "ESC"
                }
                'B' {
                    [System.Console]::CursorVisible = $true
                    Clear-Host; Show-Banner -Color "Cyan"
                    return "BACK"
                }
                'Enter' {
                    if ($SingleSelect) {
                        $MenuItems | ForEach-Object { $_.Selected = $false }
                        $MenuItems[$cursor].Selected = $true
                    }
                    break
                }
            }
            if ($key.Key -eq 'Enter') { break }
        }

        # Redraw the screen only when something changed
        if ($needsRedraw) {
            [System.Console]::SetCursorPosition(0, 0)
            Show-Banner -Color $bannerColors[$cIndex]

            Write-Host ("--- $Title ---").PadRight(60) -ForegroundColor Cyan
            Write-Host "Navigate : [UP] / [DOWN] Arrows".PadRight(60) -ForegroundColor DarkGray
            if (-not $SingleSelect) {
                Write-Host "Toggle   : [SPACEBAR]".PadRight(60) -ForegroundColor DarkGray
            }
            Write-Host "Confirm  : [ENTER]".PadRight(60) -ForegroundColor Yellow
            Write-Host ("Back/Exit: [ESC] or [B]`n").PadRight(60) -ForegroundColor Magenta

            for ($i = 0; $i -lt $MenuItems.Count; $i++) {
                $prefix = if ($i -eq $cursor) { ">>" } else { "  " }
                $checkbox = ""
                $suffix = ""

                if (-not $SingleSelect) {
                    if ($MenuItems[$i].Installed) {
                        if ($MenuItems[$i].Selected) { $checkbox = "[X]"; $suffix = " (Force Reinstall)" }
                        else { $checkbox = "[√]" }
                    }
                    else {
                        $checkbox = if ($MenuItems[$i].Selected) { "[X]" } else { "[ ]" }
                    }
                }

                $lineText = "$prefix $checkbox $($MenuItems[$i].Display)$suffix".PadRight(70)

                if ($i -eq $cursor) {
                    Write-Host $lineText -ForegroundColor Cyan
                }
                elseif ($MenuItems[$i].Installed -and -not $MenuItems[$i].Selected) {
                    Write-Host $lineText -ForegroundColor Green
                }
                elseif ($MenuItems[$i].Selected -or $SingleSelect) {
                    Write-Host $lineText -ForegroundColor White
                }
                else {
                    Write-Host $lineText -ForegroundColor DarkGray
                }
            }
            $needsRedraw = $false
        }
        Start-Sleep -Milliseconds 50
    }

    [System.Console]::CursorVisible = $true
    Clear-Host; Show-Banner -Color "Cyan"
    return $MenuItems
}

#endregion Helpers

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Package Manager Operations
# ═══════════════════════════════════════════════════════════════════════════════
#region PackageManager

function Assert-PackageManager {
    if ($DryRun) {
        Write-Log "[DRYRUN] Package manager check skipped." -Level INFO
        return
    }

    switch ($PackageManager) {
        "Winget" { Assert-Winget }
        "Chocolatey" { Assert-Chocolatey }
        default {
            Write-Log "Unknown package manager: $PackageManager. Defaulting to Winget." -Level WARN
            $script:PackageManager = "Winget"
            Assert-Winget
        }
    }
}

function Assert-Winget {
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        Write-Log "Winget is already available." -Level OK
        return
    }

    Write-Log "Winget not found — downloading Microsoft App Installer..." -Level WARN

    Invoke-Failsafe -Name "Install Winget" -Action {
        $progressPreference = 'silentlyContinue'
        $url = "https://github.com/microsoft/winget-cli/releases/latest/download/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.msixbundle"
        $output = "$env:TEMP\winget.msixbundle"
        Invoke-WebRequest -Uri $url -OutFile $output -UseBasicParsing
        Add-AppxPackage -Path $output
        Remove-Item $output -Force

        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
        [System.Environment]::GetEnvironmentVariable("Path", "User")
    }
}

function Assert-Chocolatey {
    if (Get-Command choco -ErrorAction SilentlyContinue) {
        Write-Log "Chocolatey is already available." -Level OK
        return
    }

    Write-Log "Chocolatey not found — installing..." -Level WARN

    Invoke-Failsafe -Name "Install Chocolatey" -Action {
        Set-ExecutionPolicy Bypass -Scope Process -Force
        [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
        Invoke-Expression ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
        
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
        [System.Environment]::GetEnvironmentVariable("Path", "User")
    }
}

function Install-StandardApp {
    param(
        [Parameter(Mandatory)][string]$AppId,
        [string]$DisplayName = $AppId
    )

    if ($AppId -eq $null -or $AppId -eq "") {
        Write-Log "No package ID provided for $DisplayName" -Level ERROR
        return $false
    }

    if ($DryRun) {
        Write-Log "[DRYRUN] Would install: $DisplayName ($AppId) via $PackageManager" -Level INFO
        Write-Host "  [DRYRUN] Simulating install of $DisplayName..." -ForegroundColor Yellow
        Start-Sleep -Seconds 1
        Write-Log "[DRYRUN] $DisplayName — simulated OK." -Level OK
        return $true
    }

    switch ($PackageManager) {
        "Winget" { return Install-WithWinget -AppId $AppId -DisplayName $DisplayName }
        "Chocolatey" { return Install-WithChocolatey -PackageId $AppId -DisplayName $DisplayName }
        default { 
            Write-Log "Unknown package manager: $PackageManager" -Level ERROR
            return $false 
        }
    }
}

function Install-WithWinget {
    param(
        [Parameter(Mandatory)][string]$AppId,
        [string]$DisplayName = $AppId
    )

    $idValid = $true
    try {
        $searchCheck = winget show --id $AppId -e --accept-source-agreements 2>&1 | Out-String
        if ($searchCheck -match "No package found|did not yield any results|0x8a150014") {
            $idValid = $false
        }
    }
    catch {
        $idValid = $false
    }

    if ($idValid) {
        return Invoke-Failsafe -Name "Install $DisplayName ($AppId) via Winget" -Action {
            $result = winget install --id $AppId -e `
                --accept-package-agreements `
                --accept-source-agreements `
                --silent 2>&1

            if ($LASTEXITCODE -ne 0 -and $result -notmatch "already installed|No applicable update") {
                throw "winget exited with code $LASTEXITCODE. Output: $result"
            }
        }
    }

    Write-Log "Package ID '$AppId' not found in winget. Searching for '$DisplayName'..." -Level WARN

    $fallbackId = $null
    try {
        $raw = winget search $DisplayName --accept-source-agreements 2>&1 | Out-String
        $lines = $raw -split "`n" | Where-Object { $_ -match '\S+\.\S+' -and $_ -notmatch '^-|^Name\s' }

        if ($lines.Count -eq 0) {
            Write-Log "No alternatives found for '$DisplayName'. Skipping." -Level ERROR
            return $false
        }

        $foundApps = @()
        foreach ($line in ($lines | Select-Object -First 5)) {
            $parts = ($line.Trim() -split '\s{2,}') | Where-Object { $_ -ne '' }
            if ($parts.Count -ge 2) {
                $foundApps += [pscustomobject]@{
                    Name    = $parts[0]
                    Id      = $parts[1]
                    Version = if ($parts.Count -ge 3) { $parts[2] } else { "?" }
                }
            }
        }

        if ($foundApps.Count -eq 0) {
            Write-Log "Could not parse search results for '$DisplayName'. Skipping." -Level ERROR
            return $false
        }

        Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Yellow
        Write-Host "║  PACKAGE ID CHANGED — '$AppId' no longer exists" -ForegroundColor Yellow
        Write-Host "║  Closest matches for '$DisplayName':" -ForegroundColor Yellow
        Write-Host "╠══════════════════════════════════════════════════════════╣" -ForegroundColor Yellow

        for ($i = 0; $i -lt $foundApps.Count; $i++) {
            $entry = "  [$($i+1)] $($foundApps[$i].Name)  →  $($foundApps[$i].Id)  (v$($foundApps[$i].Version))"
            Write-Host ("║" + $entry.PadRight(58) + "║") -ForegroundColor White
        }

        Write-Host ("║  [S] Skip this app".PadRight(59) + "║") -ForegroundColor DarkGray
        Write-Host "╚══════════════════════════════════════════════════════════╝" -ForegroundColor Yellow

        Write-Host "Pick a number (1-$($foundApps.Count)) or [S] to skip: " -NoNewline -ForegroundColor Cyan

        while ($true) {
            $pick = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
            if ($pick -eq 'S') {
                Write-Host "S" -ForegroundColor Red
                Write-Log "User skipped fallback for '$DisplayName'." -Level WARN
                return $false
            }
            $num = 0
            if ([int]::TryParse($pick, [ref]$num) -and $num -ge 1 -and $num -le $foundApps.Count) {
                Write-Host $pick -ForegroundColor Green
                $fallbackId = $foundApps[$num - 1].Id
                Write-Log "User chose fallback: $fallbackId (was: $AppId)" -Level INFO
                break
            }
        }
    }
    catch {
        Write-Log "Fallback search failed for '$DisplayName': $($_.Exception.Message)" -Level ERROR
        return $false
    }

    if ($fallbackId) {
        return Invoke-Failsafe -Name "Install $DisplayName (fallback: $fallbackId) via Winget" -Action {
            $result = winget install --id $fallbackId -e `
                --accept-package-agreements `
                --accept-source-agreements `
                --silent 2>&1

            if ($LASTEXITCODE -ne 0 -and $result -notmatch "already installed|No applicable update") {
                throw "winget exited with code $LASTEXITCODE. Output: $result"
            }
        }
    }
    
    return $false
}

function Install-WithChocolatey {
    param(
        [Parameter(Mandatory)][string]$PackageId,
        [string]$DisplayName = $PackageId
    )

    $exists = $false
    try {
        $searchResult = choco search $PackageId --exact --limit-output 2>&1 | Out-String
        if ($searchResult -match "^$PackageId\|") {
            $exists = $true
        }
    }
    catch {
        $exists = $false
    }

    if (-not $exists) {
        Write-Log "Package '$PackageId' not found in Chocolatey repository. Attempting search..." -Level WARN
        
        try {
            $searchResult = choco search $PackageId --limit-output 2>&1 | Out-String
            $lines = $searchResult -split "`n" | Where-Object { $_ -match "^\S+\|" } | Select-Object -First 5
            
            if ($lines.Count -eq 0) {
                Write-Log "No alternatives found in Chocolatey for '$PackageId'. Skipping." -Level ERROR
                return $false
            }

            $foundPackages = @()
            foreach ($line in $lines) {
                $parts = $line -split "\|"
                if ($parts.Count -ge 2) {
                    $foundPackages += [pscustomobject]@{
                        Id      = $parts[0]
                        Version = $parts[1]
                    }
                }
            }

            if ($foundPackages.Count -eq 0) {
                Write-Log "Could not parse Chocolatey search results. Skipping." -Level ERROR
                return $false
            }

            Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Yellow
            Write-Host "║  PACKAGE NOT FOUND — '$PackageId'" -ForegroundColor Yellow
            Write-Host "║  Closest matches in Chocolatey:" -ForegroundColor Yellow
            Write-Host "╠══════════════════════════════════════════════════════════╣" -ForegroundColor Yellow

            for ($i = 0; $i -lt $foundPackages.Count; $i++) {
                $entry = "  [$($i+1)] $($foundPackages[$i].Id)  (v$($foundPackages[$i].Version))"
                Write-Host ("║" + $entry.PadRight(58) + "║") -ForegroundColor White
            }

            Write-Host ("║  [S] Skip this app".PadRight(59) + "║") -ForegroundColor DarkGray
            Write-Host "╚══════════════════════════════════════════════════════════╝" -ForegroundColor Yellow

            Write-Host "Pick a number (1-$($foundPackages.Count)) or [S] to skip: " -NoNewline -ForegroundColor Cyan

            while ($true) {
                $pick = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
                if ($pick -eq 'S') {
                    Write-Host "S" -ForegroundColor Red
                    Write-Log "User skipped fallback for '$DisplayName'." -Level WARN
                    return $false
                }
                $num = 0
                if ([int]::TryParse($pick, [ref]$num) -and $num -ge 1 -and $num -le $foundPackages.Count) {
                    Write-Host $pick -ForegroundColor Green
                    $PackageId = $foundPackages[$num - 1].Id
                    Write-Log "User chose Chocolatey package: $PackageId" -Level INFO
                    break
                }
            }
        }
        catch {
            Write-Log "Chocolatey search failed: $($_.Exception.Message)" -Level ERROR
            return $false
        }
    }

    return Invoke-Failsafe -Name "Install $DisplayName ($PackageId) via Chocolatey" -Action {
        $result = choco install $PackageId -y --no-progress 2>&1
        
        if ($LASTEXITCODE -ne 0 -and $result -notmatch "already installed|is already installed") {
            throw "Chocolatey exited with code $LASTEXITCODE. Output: $result"
        }
    }
}

#endregion PackageManager

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Core Application Installers
# ═══════════════════════════════════════════════════════════════════════════════
#region CoreInstallers

function Install-TightVNC {
    Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Magenta
    Write-Host "║              TightVNC Configuration                      ║" -ForegroundColor Magenta
    Write-Host "╠══════════════════════════════════════════════════════════╣" -ForegroundColor Magenta
    Write-Host "║  [1] No Password  (open access — home network)           ║" -ForegroundColor White
    Write-Host "║  [2] Set Password (max 8 chars — TightVNC limit)         ║" -ForegroundColor White
    Write-Host "║  [S] Skip TightVNC                                       ║" -ForegroundColor DarkGray
    Write-Host "╚══════════════════════════════════════════════════════════╝" -ForegroundColor Magenta

    Write-Host "Choose (1/2/S): " -NoNewline -ForegroundColor Cyan

    $vncMode = $null
    $vncPassword = ""
    while ($true) {
        $pick = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        if ($pick -eq '1') {
            Write-Host "1 — No Password" -ForegroundColor Green
            $vncMode = "NoAuth"
            break
        }
        elseif ($pick -eq '2') {
            Write-Host "2 — Set Password" -ForegroundColor Green
            $vncMode = "Password"
            break
        }
        elseif ($pick -eq 'S') {
            Write-Host "S — Skipped" -ForegroundColor Red
            Write-Log "User skipped TightVNC installation." -Level WARN
            return $false
        }
    }

    if ($vncMode -eq "Password") {
        Write-Host "Note: TightVNC limits passwords to 8 characters." -ForegroundColor Yellow
        $securePass = Read-Host -AsSecureString "Enter VNC password"
        $vncPassword = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto(
            [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($securePass)
        )
        if ([string]::IsNullOrWhiteSpace($vncPassword)) {
            Write-Log "Empty password entered — falling back to No Auth mode." -Level WARN
            $vncMode = "NoAuth"
        }
    }

    if ($DryRun) {
        Write-Log "[DRYRUN] Would install TightVNC: mode=$vncMode via $PackageManager" -Level INFO
        Write-Host "  [DRYRUN] Simulating TightVNC install..." -ForegroundColor Yellow
        Start-Sleep -Seconds 1
        Write-Log "[DRYRUN] TightVNC — simulated OK." -Level OK
        return $true
    }

    # Chocolatey installation - download MSI directly for full control
    if ($PackageManager -eq "Chocolatey") {
        return Invoke-Failsafe -Name "Install TightVNC ($vncMode) via Chocolatey/MSI" -Action {
            $tempDir = "$env:TEMP\TightVNCInstall"
            New-Item -ItemType Directory -Path $tempDir -Force | Out-Null
            
            try {
                $arch = if ([Environment]::Is64BitOperatingSystem) { "64bit" } else { "32bit" }
                $msiUrl = "https://github.com/Tight-VNC/tightvnc/releases/download/v2.8.85/tightvnc-2.8.85-gpl-setup-$arch.msi"
                $msiPath = "$tempDir\tightvnc.msi"
                
                Write-Log "Downloading TightVNC MSI ($arch)..." -Level INFO
                Invoke-WebRequest -Uri $msiUrl -OutFile $msiPath -UseBasicParsing
                
                # Build MSI arguments for server-only install
                $msiArgs = @(
                    "/i `"$msiPath`""
                    "/quiet"
                    "/norestart"
                    "ADDLOCAL=Server"
                    "SERVER_REGISTER_AS_SERVICE=1"
                    "SERVER_ADD_FIREWALL_EXCEPTION=1"
                    "SET_USEVNCAUTHENTICATION=1"
                )

                if ($vncMode -eq "NoAuth") {
                    $msiArgs += "VALUE_OF_USEVNCAUTHENTICATION=0"
                }
                else {
                    $msiArgs += "VALUE_OF_USEVNCAUTHENTICATION=1"
                    $msiArgs += "SET_PASSWORD=1"
                    $msiArgs += "VALUE_OF_PASSWORD=$vncPassword"
                    $msiArgs += "SET_VIEWONLYPASSWORD=1" 
                    $msiArgs += "VALUE_OF_VIEWONLYPASSWORD=$vncPassword"
                }

                # Add additional settings
                $msiArgs += @(
                    "SET_USECONTROLAUTHENTICATION=1"
                    "VALUE_OF_USECONTROLAUTHENTICATION=0"
                    "SET_ACCEPTHTTPCONNECTIONS=1"
                    "VALUE_OF_ACCEPTHTTPCONNECTIONS=0"
                    "SET_REMOVEWALLPAPER=1"
                    "VALUE_OF_REMOVEWALLPAPER=0"
                    "SET_ENABLEFILETRANSFERS=1"
                    "VALUE_OF_ENABLEFILETRANSFERS=1"
                    "SET_CONNECTTOREMOTESESSION=1"
                    "VALUE_OF_CONNECTTOREMOTESESSION=1"
                    "SET_RUNCONTROLINTERFACE=1"
                    "VALUE_OF_RUNCONTROLINTERFACE=0"
                    "SET_BLOCKLOCALINPUT=1"
                    "VALUE_OF_BLOCKLOCALINPUT=1"
                )

                $msiArgString = $msiArgs -join " "
                Write-Log "Installing with MSI arguments" -Level INFO
                
                $process = Start-Process -FilePath "msiexec.exe" -ArgumentList $msiArgString -Wait -PassThru
                
                if ($process.ExitCode -ne 0 -and $process.ExitCode -ne 3010) {
                    throw "MSI installation failed with exit code $($process.ExitCode)"
                }
                
                Write-Log "TightVNC installed successfully via direct MSI" -Level OK
                
                # Start the service if not already running
                Start-Service -Name "tvnserver" -ErrorAction SilentlyContinue
            }
            finally {
                Remove-Item $tempDir -Recurse -Force -ErrorAction SilentlyContinue
            }
        }
    }

    # Winget installation with MSI overrides
    return Invoke-Failsafe -Name "Install TightVNC ($vncMode) via Winget" -Action {
        $overrideParts = @(
            "/quiet"
            "/norestart"
            "ADDLOCAL=Server"
            "SET_USECONTROLAUTHENTICATION=1"
            "VALUE_OF_USECONTROLAUTHENTICATION=0"
            "SET_ACCEPTHTTPCONNECTIONS=1"
            "VALUE_OF_ACCEPTHTTPCONNECTIONS=0"
            "SET_REMOVEWALLPAPER=1"
            "VALUE_OF_REMOVEWALLPAPER=0"
            "SET_ENABLEFILETRANSFERS=1"
            "VALUE_OF_ENABLEFILETRANSFERS=1"
            "SET_CONNECTTOREMOTESESSION=1"
            "VALUE_OF_CONNECTTOREMOTESESSION=1"
            "SET_RUNCONTROLINTERFACE=1"
            "VALUE_OF_RUNCONTROLINTERFACE=0"
            "SET_BLOCKLOCALINPUT=1"
            "VALUE_OF_BLOCKLOCALINPUT=1"
        )

        if ($vncMode -eq "NoAuth") {
            $overrideParts += "SET_USEVNCAUTHENTICATION=1"
            $overrideParts += "VALUE_OF_USEVNCAUTHENTICATION=0"
        }
        else {
            $overrideParts += "SET_USEVNCAUTHENTICATION=1"
            $overrideParts += "VALUE_OF_USEVNCAUTHENTICATION=1"
            $overrideParts += "SET_PASSWORD=1"
            $overrideParts += "VALUE_OF_PASSWORD=$vncPassword"
            $overrideParts += "SET_VIEWONLYPASSWORD=1"
            $overrideParts += "VALUE_OF_VIEWONLYPASSWORD=$vncPassword"
        }

        $vncOverride = $overrideParts -join " "

        winget install --id TightVNC.TightVNC -e `
            --accept-package-agreements `
            --accept-source-agreements `
            --override $vncOverride

        if ($LASTEXITCODE -ne 0) {
            throw "TightVNC winget install exited with code $LASTEXITCODE"
        }

        Write-Log "TightVNC installed: mode=$vncMode, server-only, no tray, file-transfer ON, RDP session, local input blocked." -Level OK
    }
}

function Install-ZeroTier-AutoJoin {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would install ZeroTier One and join network $ZeroTierNetworkId via $PackageManager" -Level INFO
        Write-Host "  [DRYRUN] Simulating ZeroTier install + network join..." -ForegroundColor Yellow
        Start-Sleep -Seconds 1
        Write-Log "[DRYRUN] ZeroTier — simulated OK." -Level OK
        return $true
    }

    $installOk = Invoke-Failsafe -Name "Install ZeroTier One via $PackageManager" -Action {
        if ($PackageManager -eq "Chocolatey") {
            $result = choco install zerotier-one -y --no-progress 2>&1
            if ($LASTEXITCODE -ne 0 -and $result -notmatch "already installed") {
                throw "Chocolatey ZeroTier install exited with code $LASTEXITCODE"
            }
        }
        else {
            winget install --id ZeroTier.ZeroTierOne -e `
                --accept-package-agreements `
                --accept-source-agreements `
                --silent

            if ($LASTEXITCODE -ne 0) {
                throw "ZeroTier winget install exited with code $LASTEXITCODE"
            }
        }
    }

    if (-not $installOk) { return $false }

    # Join network - handle different CLI locations for winget vs chocolatey
    return Invoke-Failsafe -Name "Join ZeroTier Network ($ZeroTierNetworkId)" -Action {
        Write-Log "Waiting 8 seconds for ZeroTier service to initialize..." -Level INFO
        Start-Sleep -Seconds 8

        $joinOutput = $null
        $cliFound = $false
        
        # Try multiple possible CLI locations (order matters)
        $possibleCliPaths = @(
            # Winget installation paths
            "C:\ProgramData\ZeroTier\One\zerotier-cli.bat",
            "C:\ProgramData\ZeroTier\One\zerotier-cli.exe",
            # Chocolatey installation paths
            "C:\Program Files (x86)\ZeroTier\One\zerotier-cli.exe",
            "C:\Program Files\ZeroTier\One\zerotier-cli.exe",
            # Direct service executable (can be used with -q switch)
            "C:\ProgramData\ZeroTier\One\zerotier-one_x64.exe",
            "C:\ProgramData\ZeroTier\One\zerotier-one_x86.exe"
        )

        foreach ($cliPath in $possibleCliPaths) {
            if (Test-Path $cliPath) {
                Write-Log "Found ZeroTier CLI at: $cliPath" -Level INFO
                $cliFound = $true
                
                try {
                    if ($cliPath -match "zerotier-one_x(64|86)\.exe") {
                        # Use the service executable with -q switch for query/join commands
                        $joinOutput = & $cliPath -q join $ZeroTierNetworkId 2>&1
                    }
                    else {
                        # Use standard CLI
                        $joinOutput = & $cliPath join $ZeroTierNetworkId 2>&1
                    }
                    Write-Log "ZeroTier join output: $joinOutput" -Level INFO
                    
                    if ($joinOutput -match "200 join OK|already a member") {
                        Write-Log "Successfully joined ZeroTier network" -Level OK
                        return
                    }
                }
                catch {
                    Write-Log "Failed to use CLI at $cliPath`: $($_.Exception.Message)" -Level WARN
                    continue
                }
            }
        }

        # If no CLI found in standard locations, try PATH
        if (-not $cliFound) {
            Write-Log "CLI not found in standard locations, trying PATH..." -Level WARN
            try {
                $joinOutput = zerotier-cli join $ZeroTierNetworkId 2>&1
                Write-Log "ZeroTier join output (PATH): $joinOutput" -Level INFO
                
                if ($joinOutput -match "200 join OK|already a member") {
                    Write-Log "Successfully joined ZeroTier network via PATH" -Level OK
                    return
                }
            }
            catch {
                Write-Log "PATH zerotier-cli also failed: $($_.Exception.Message)" -Level WARN
            }
        }

        # Last resort: Use the API directly via PowerShell
        Write-Log "Attempting network join via ZeroTier API..." -Level WARN
        try {
            # ZeroTier has a local HTTP API on port 9993
            $apiToken = Get-Content "$env:ProgramData\ZeroTier\One\authtoken.secret" -ErrorAction Stop
            $headers = @{ "X-ZT1-Auth" = $apiToken }
            $body = @{ id = $ZeroTierNetworkId; allowManaged = $true } | ConvertTo-Json
            
            $response = Invoke-RestMethod -Uri "http://127.0.0.1:9993/network/$ZeroTierNetworkId" -Method Post -Headers $headers -Body $body -ErrorAction Stop
            Write-Log "Successfully joined via API: $($response | ConvertTo-Json -Compress)" -Level OK
        }
        catch {
            throw "All join methods failed. Last error: $($_.Exception.Message)"
        }
    }
}

#endregion CoreInstallers

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Repair & Security Tools
# ═══════════════════════════════════════════════════════════════════════════════
#region Repair Tools

function Repair-WingetFull {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would repair winget with full dependencies" -Level INFO
        Write-Host "`n  [DRYRUN] Simulating winget repair..." -ForegroundColor Yellow
        Start-Sleep -Seconds 2
        Write-Log "[DRYRUN] Winget repair simulated OK." -Level OK
        return $true
    }

    Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Cyan
    Write-Host "║           WINGET REPAIR & INSTALLATION                   ║" -ForegroundColor Cyan
    Write-Host "╠══════════════════════════════════════════════════════════╣" -ForegroundColor Cyan
    Write-Host "║  This will download and install:                         ║" -ForegroundColor White
    Write-Host "║    • Windows App Runtime 1.8                             ║" -ForegroundColor White
    Write-Host "║    • VCLibs UWP Desktop Runtime                          ║" -ForegroundColor White
    Write-Host "║    • Microsoft.DesktopAppInstaller (winget)              ║" -ForegroundColor White
    Write-Host "╚══════════════════════════════════════════════════════════╝" -ForegroundColor Cyan

    Write-Host "`nProceed with winget repair? (Y/N): " -NoNewline -ForegroundColor Yellow
    $confirm = $null
    while ($true) {
        $k = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        if ($k -eq 'Y') { Write-Host "Y" -ForegroundColor Green; $confirm = $true; break }
        if ($k -eq 'N') { Write-Host "N" -ForegroundColor Red; $confirm = $false; break }
    }

    if (-not $confirm) {
        Write-Log "Winget repair cancelled by user." -Level WARN
        return $false
    }

    return Invoke-Failsafe -Name "Repair Winget (Full Installation)" -Action {
        $tempDir = "$env:TEMP\WingetRepair"
        New-Item -ItemType Directory -Path $tempDir -Force | Out-Null
        $ProgressPreference = 'SilentlyContinue'

        try {
            Write-Log "Fetching latest winget release information..." -Level INFO
            $apiUrl = "https://api.github.com/repos/microsoft/winget-cli/releases/latest"
            $release = Invoke-RestMethod -Uri $apiUrl -UseBasicParsing
            
            $tagName = $release.tag_name
            Write-Log "Latest release: $tagName" -Level INFO

            $msixBundleUrl = $release.assets | Where-Object { $_.name -like "*.msixbundle" } | Select-Object -ExpandProperty browser_download_url -First 1
            $depsZipUrl = $release.assets | Where-Object { $_.name -like "*Dependencies*.zip" } | Select-Object -ExpandProperty browser_download_url -First 1
            $licenseUrl = $release.assets | Where-Object { $_.name -like "*License*.xml" } | Select-Object -ExpandProperty browser_download_url -First 1

            if (-not $msixBundleUrl) {
                throw "Could not find MSIX bundle in latest release"
            }

            Write-Log "Found MSIX bundle: $msixBundleUrl" -Level INFO

            if ($depsZipUrl) {
                Write-Log "Downloading dependencies package..." -Level INFO
                $depsZip = "$tempDir\dependencies.zip"
                Invoke-WebRequest -Uri $depsZipUrl -OutFile $depsZip -UseBasicParsing
                Expand-Archive -Path $depsZip -DestinationPath $tempDir -Force

                $x64Dir = Join-Path $tempDir "x64"
                if (Test-Path $x64Dir) {
                    $deps = Get-ChildItem -Path $x64Dir -Filter "*.appx" -ErrorAction SilentlyContinue | Sort-Object Name
                    foreach ($dep in $deps) {
                        Write-Log "Installing dependency: $($dep.Name)" -Level INFO
                        try {
                            Add-AppxPackage -Path $dep.FullName -ErrorAction Stop
                            Write-Log "  ✓ Installed: $($dep.Name)" -Level OK
                        }
                        catch {
                            Write-Log "  ⚠ Could not install $($dep.Name) (may already exist): $($_.Exception.Message)" -Level WARN
                        }
                    }
                }
            }
            else {
                Write-Log "No dependencies package found, attempting to install VCLibs directly..." -Level WARN
                $vcLibsUrl = "https://aka.ms/Microsoft.VCLibs.x64.14.00.Desktop.appx"
                $vcLibsPath = "$tempDir\Microsoft.VCLibs.x64.14.00.Desktop.appx"
                try {
                    Invoke-WebRequest -Uri $vcLibsUrl -OutFile $vcLibsPath -UseBasicParsing
                    Add-AppxPackage -Path $vcLibsPath -ErrorAction SilentlyContinue
                    Write-Log "Installed VCLibs from aka.ms" -Level OK
                }
                catch {
                    Write-Log "Could not install VCLibs: $($_.Exception.Message)" -Level WARN
                }
            }

            Write-Log "Downloading Microsoft.DesktopAppInstaller..." -Level INFO
            $wingetBundle = "$tempDir\winget.msixbundle"
            Invoke-WebRequest -Uri $msixBundleUrl -OutFile $wingetBundle -UseBasicParsing

            Write-Log "Installing Microsoft.DesktopAppInstaller (winget)..." -Level INFO
            
            try {
                Add-AppxPackage -Path $wingetBundle -ErrorAction Stop
                Write-Log "  ✓ Winget installed successfully" -Level OK
            }
            catch {
                Write-Log "Standard install failed, attempting provisioned package install..." -Level WARN
                
                try {
                    Add-AppxProvisionedPackage -Online -PackagePath $wingetBundle -SkipLicense -ErrorAction Stop | Out-Null
                    Write-Log "  ✓ Winget installed as provisioned package (SkipLicense)" -Level OK
                }
                catch {
                    if ($licenseUrl) {
                        Write-Log "Attempting install with license file..." -Level WARN
                        $licenseFile = "$tempDir\license.xml"
                        Invoke-WebRequest -Uri $licenseUrl -OutFile $licenseFile -UseBasicParsing
                        Add-AppxProvisionedPackage -Online -PackagePath $wingetBundle -LicensePath $licenseFile -ErrorAction Stop | Out-Null
                        Write-Log "  ✓ Winget installed as provisioned package (with license)" -Level OK
                    }
                    else {
                        throw "All installation methods failed. Last error: $($_.Exception.Message)"
                    }
                }
            }

            $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
            [System.Environment]::GetEnvironmentVariable("Path", "User")

            $wingetCmd = Get-Command winget -ErrorAction SilentlyContinue
            if ($wingetCmd) {
                $version = winget --version 2>$null
                Write-Log "Winget verified: $version at $($wingetCmd.Source)" -Level OK
            }
            else {
                Write-Log "Winget command not found in PATH immediately. You may need to restart PowerShell." -Level WARN
            }
        }
        finally {
            if (Test-Path $tempDir) {
                Remove-Item $tempDir -Recurse -Force -ErrorAction SilentlyContinue
                Write-Log "Cleaned up temporary files" -Level INFO
            }
        }
    }
}

function Repair-ChocolateyFull {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would repair/reinstall Chocolatey" -Level INFO
        Write-Host "`n  [DRYRUN] Simulating Chocolatey repair..." -ForegroundColor Yellow
        Start-Sleep -Seconds 2
        Write-Log "[DRYRUN] Chocolatey repair simulated OK." -Level OK
        return $true
    }

    Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Cyan
    Write-Host "║         CHOCOLATEY REPAIR & INSTALLATION                 ║" -ForegroundColor Cyan
    Write-Host "╠══════════════════════════════════════════════════════════╣" -ForegroundColor Cyan
    Write-Host "║  This will:                                              ║" -ForegroundColor White
    Write-Host "║    • Uninstall existing Chocolatey (if corrupt)          ║" -ForegroundColor White
    Write-Host "║    • Reinstall Chocolatey from official source           ║" -ForegroundColor White
    Write-Host "║    • Update environment PATH                             ║" -ForegroundColor White
    Write-Host "╚══════════════════════════════════════════════════════════╝" -ForegroundColor Cyan

    Write-Host "`nProceed with Chocolatey repair? (Y/N): " -NoNewline -ForegroundColor Yellow
    $confirm = $null
    while ($true) {
        $k = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        if ($k -eq 'Y') { Write-Host "Y" -ForegroundColor Green; $confirm = $true; break }
        if ($k -eq 'N') { Write-Host "N" -ForegroundColor Red; $confirm = $false; break }
    }

    if (-not $confirm) {
        Write-Log "Chocolatey repair cancelled by user." -Level WARN
        return $false
    }

    return Invoke-Failsafe -Name "Repair Chocolatey (Full Installation)" -Action {
        $chocoPath = "$env:ProgramData\chocolatey"
        if (Test-Path $chocoPath) {
            Write-Log "Existing Chocolatey installation found. Attempting cleanup..." -Level WARN
            try {
                if (Get-Command choco -ErrorAction SilentlyContinue) {
                    choco uninstall chocolatey -y 2>&1 | Out-Null
                }
                Remove-Item $chocoPath -Recurse -Force -ErrorAction SilentlyContinue
                Write-Log "Cleaned up existing Chocolatey installation" -Level OK
            }
            catch {
                Write-Log "Could not fully cleanup existing installation: $($_.Exception.Message)" -Level WARN
            }
        }

        Write-Log "Installing Chocolatey from official source..." -Level INFO
        Set-ExecutionPolicy Bypass -Scope Process -Force
        [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
        Invoke-Expression ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
        
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
        [System.Environment]::GetEnvironmentVariable("Path", "User")

        $chocoCmd = Get-Command choco -ErrorAction SilentlyContinue
        if ($chocoCmd) {
            $version = choco --version 2>$null
            Write-Log "Chocolatey verified: v$version at $($chocoCmd.Source)" -Level OK
        }
        else {
            throw "Chocolatey installation verification failed"
        }
    }
}

function Switch-PackageManager {
    Write-Host "`n╔══════════════════════════════════════════════════════════╗" -ForegroundColor Cyan
    Write-Host "║         SWITCH PACKAGE MANAGER                           ║" -ForegroundColor Cyan
    Write-Host "╠══════════════════════════════════════════════════════════╣" -ForegroundColor Cyan
    Write-Host "║  Current package manager: $PackageManager" -ForegroundColor Yellow
    Write-Host "║                                                          ║" -ForegroundColor White
    Write-Host "║  [1] Switch to Winget (Microsoft)                        ║" -ForegroundColor White
    Write-Host "║  [2] Switch to Chocolatey (Community)                    ║" -ForegroundColor White
    Write-Host "║  [S] Keep current setting                                ║" -ForegroundColor DarkGray
    Write-Host "╚══════════════════════════════════════════════════════════╝" -ForegroundColor Cyan

    Write-Host "`nSelect package manager (1/2/S): " -NoNewline -ForegroundColor Yellow
    
    while ($true) {
        $pick = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        
        if ($pick -eq '1') {
            Write-Host "1 - Winget" -ForegroundColor Green
            if ($PackageManager -ne "Winget") {
                $script:PackageManager = "Winget"
                Write-Log "Package manager switched to: Winget" -Level OK
                Write-Host "`n  Note: Winget will be used for all future installations." -ForegroundColor Cyan
                Write-Host "  Run 'Repair/Install Winget + Dependencies' if needed." -ForegroundColor Yellow
            }
            else {
                Write-Log "Package manager already set to Winget" -Level INFO
            }
            return $true
        }
        elseif ($pick -eq '2') {
            Write-Host "2 - Chocolatey" -ForegroundColor Green
            if ($PackageManager -ne "Chocolatey") {
                $script:PackageManager = "Chocolatey"
                Write-Log "Package manager switched to: Chocolatey" -Level OK
                Write-Host "`n  Note: Chocolatey will be used for all future installations." -ForegroundColor Cyan
                Write-Host "  Run 'Repair/Install Chocolatey' if needed." -ForegroundColor Yellow
            }
            else {
                Write-Log "Package manager already set to Chocolatey" -Level INFO
            }
            return $true
        }
        elseif ($pick -eq 'S') {
            Write-Host "S - Keep current" -ForegroundColor DarkGray
            Write-Log "Package manager switch cancelled. Current: $PackageManager" -Level INFO
            return $false
        }
    }
}

function Set-TemporaryCloudflareDNS {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would set temporary Cloudflare DNS (1.1.1.1 / 1.0.0.1)" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "Set Temporary Cloudflare DNS" -Action {
        $adapter = Get-NetAdapter |
        Where-Object { $_.Status -eq 'Up' -and $_.InterfaceAlias -notmatch 'ZeroTier|Virtual|vEthernet|Loopback' } |
        Select-Object -First 1

        if (-not $adapter) { throw "No active physical network adapter found." }

        Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ServerAddresses ("1.1.1.1", "1.0.0.1")
        Clear-DnsClientCache
        Write-Log "Cloudflare DNS applied to '$($adapter.InterfaceAlias)'. Will revert on menu exit." -Level OK

        $script:TempDnsAdapter = $adapter
    }
}

function Restore-DNS {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would restore DNS to DHCP" -Level INFO
        $script:TempDnsAdapter = $null
        return
    }
    
    if ($script:TempDnsAdapter) {
        Invoke-Failsafe -Name "Revert DNS on $($script:TempDnsAdapter.InterfaceAlias)" -Action {
            Set-DnsClientServerAddress -InterfaceIndex $script:TempDnsAdapter.ifIndex -ResetServerAddresses
            Clear-DnsClientCache
            $script:TempDnsAdapter = $null
        }
    }
}

function Invoke-SFC {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would run SFC /scannow" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "SFC /scannow" -Action {
        sfc /scannow
        if ($LASTEXITCODE -ne 0) {
            Write-Log "SFC reported issues — check CBS.log for details." -Level WARN
        }
    }
}

function Invoke-DISM {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would run DISM /RestoreHealth (Standard)" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "DISM RestoreHealth (Standard)" -Action {
        $env:HTTP_PROXY = ""
        $env:HTTPS_PROXY = ""
        DISM /Online /Cleanup-Image /RestoreHealth
    }
}

function Invoke-DISM-WithProxy {
    $proxyStr = Read-Host "Enter Proxy Address (e.g., http://192.168.1.50:8080 )"

    if ([string]::IsNullOrWhiteSpace($proxyStr)) {
        Write-Log "No proxy entered — skipping DISM with proxy." -Level WARN
        return $false
    }

    if ($DryRun) {
        Write-Log "[DRYRUN] Would run DISM /RestoreHealth via proxy $proxyStr" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "DISM RestoreHealth (Proxy: $proxyStr)" -Action {
        $env:HTTP_PROXY = $proxyStr
        $env:HTTPS_PROXY = $proxyStr
        netsh winhttp set proxy $proxyStr | Out-Null
        Write-Log "System proxy set to $proxyStr" -Level INFO

        DISM /Online /Cleanup-Image /RestoreHealth

        $env:HTTP_PROXY = ""
        $env:HTTPS_PROXY = ""
        netsh winhttp reset proxy | Out-Null
        Write-Log "Proxy settings reset." -Level OK
    }
}

