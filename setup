#region Configuration

# --- DryRun Mode ---
# Set to $true to test the full UI without installing anything.
# All winget commands are simulated. Menus, prompts, and logging work normally.
$DryRun = $false

# --- ZeroTier ---
$ZeroTierNetworkId = "17d709436c5d1c9e"                     # Network to auto-join

# --- Logging ---
$LogFile = Join-Path ([Environment]::GetFolderPath("Desktop")) "OMNITX_Setup_Log.txt"

# --- App Catalog ---
# Each entry: Display name (shown to user), winget package ID, and a Type
# tag that controls special post-install behavior.
#
#   Type values:
#     Standard  - installed silently via winget, no extra steps
#     VNC       - TightVNC with full configuration prompt
#     ZeroTier  - installed then auto-joined to $ZeroTierNetworkId
#
# Apps are presented ONE BY ONE. The user confirms each individually.
#
$AppCatalog = @(
    @{ Display = "7-Zip"; Id = "7zip.7zip"; Type = "Standard" }
    @{ Display = "WinRAR"; Id = "RARLab.WinRAR"; Type = "Standard" }
    @{ Display = "LocalSend"; Id = "localsend.localsend"; Type = "Standard" }
    @{ Display = "Everything (Alpha)"; Id = "voidtools.Everything.Alpha"; Type = "Standard" }
    @{ Display = "Notepad++"; Id = "Notepad++.Notepad++"; Type = "Standard" }
    @{ Display = "PotPlayer"; Id = "Daum.PotPlayer"; Type = "Standard" }
    @{ Display = "qBittorrent"; Id = "qBittorrent.qBittorrent"; Type = "Standard" }
    @{ Display = "Cloudflare WARP"; Id = "Cloudflare.Warp"; Type = "Standard" }
    @{ Display = "TightVNC"; Id = "TightVNC.TightVNC"; Type = "VNC" }
    @{ Display = "ZeroTier"; Id = "ZeroTier.ZeroTierOne"; Type = "ZeroTier" }
)

#endregion Configuration

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Logging Subsystem
# ═══════════════════════════════════════════════════════════════════════════════
#region Logging

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet("INFO", "WARN", "ERROR", "OK")][string]$Level = "INFO"
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "[$timestamp] [$Level] $Message"

    # Append to log file (create if missing)
    try { $entry | Out-File -FilePath $LogFile -Append -Encoding UTF8 } catch { }

    # Console color map
    $colorMap = @{ INFO = "White"; WARN = "Yellow"; ERROR = "Red"; OK = "Green" }
    Write-Host $entry -ForegroundColor $colorMap[$Level]
}

#endregion Logging

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Utility Helpers
# ═══════════════════════════════════════════════════════════════════════════════
#region Helpers

function Invoke-Failsafe {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][scriptblock]$Action
    )
    try {
        Write-Log "START  > $Name" -Level INFO
        & $Action
        Write-Log "DONE   [OK] $Name" -Level OK
        return $true
    }
    catch {
        Write-Log "FAILED [X] $Name - $($_.Exception.Message)" -Level ERROR
        return $false
    }
}

function Show-Banner {
    param([string]$Color = "Cyan")

    $lines = @(
        "  @@@@@   @@@   @@@  @@@   @@  @@  @@@@@@@  @@   @@ "
        " @@   @@  @@@@ @@@@  @@@@  @@  @@    @@      @@ @@  "
        " @@   @@  @@ @@@ @@  @@ @@ @@  @@    @@       @@@   "
        " @@   @@  @@     @@  @@  @@@@  @@    @@      @@ @@  "
        "  @@@@@   @@     @@  @@   @@@  @@    @@     @@   @@ "
    )
    foreach ($l in $lines) { Write-Host $l -ForegroundColor $Color }
    Write-Host "`nRunning with Administrator privileges.`n" -ForegroundColor Green
    if ($DryRun) {
        Write-Host "  [DRY RUN MODE] Nothing will be installed`n" -ForegroundColor Yellow
    }
}

function Show-Menu {
    param(
        [string]$Title,
        [array]$MenuItems,
        [switch]$SingleSelect
    )

    $cursor = 0
    [System.Console]::CursorVisible = $false
    Clear-Host

    $bannerColors = @("Cyan", "Magenta", "Yellow", "Green", "Red", "Blue", "White")
    $cIndex = 0
    $lastTime = Get-Date
    $needsRedraw = $true

    while ($true) {
        # Cycle banner color every second for visual flair
        $now = Get-Date
        if (($now - $lastTime).TotalMilliseconds -ge 1000) {
            $cIndex = ($cIndex + 1) % $bannerColors.Count
            $lastTime = $now
            $needsRedraw = $true
        }

        # Handle key presses
        if ([System.Console]::KeyAvailable) {
            $key = [System.Console]::ReadKey($true)

            switch ($key.Key) {
                'UpArrow' { if ($cursor -gt 0) { $cursor--; $needsRedraw = $true } }
                'DownArrow' { if ($cursor -lt ($MenuItems.Count - 1)) { $cursor++; $needsRedraw = $true } }
                'Spacebar' {
                    if (-not $SingleSelect) {
                        $MenuItems[$cursor].Selected = -not $MenuItems[$cursor].Selected
                        $needsRedraw = $true
                    }
                }
                'Escape' {
                    [System.Console]::CursorVisible = $true
                    Clear-Host; Show-Banner -Color "Cyan"
                    return "ESC"
                }
                'B' {
                    [System.Console]::CursorVisible = $true
                    Clear-Host; Show-Banner -Color "Cyan"
                    return "BACK"
                }
                'Enter' {
                    if ($SingleSelect) {
                        $MenuItems | ForEach-Object { $_.Selected = $false }
                        $MenuItems[$cursor].Selected = $true
                    }
                    break
                }
            }
            if ($key.Key -eq 'Enter') { break }
        }

        # Redraw the screen only when something changed
        if ($needsRedraw) {
            [System.Console]::SetCursorPosition(0, 0)
            Show-Banner -Color $bannerColors[$cIndex]

            Write-Host ("--- $Title ---").PadRight(60) -ForegroundColor Cyan
            Write-Host "Navigate : [UP] / [DOWN] Arrows".PadRight(60) -ForegroundColor DarkGray
            if (-not $SingleSelect) {
                Write-Host "Toggle   : [SPACEBAR]".PadRight(60) -ForegroundColor DarkGray
            }
            Write-Host "Confirm  : [ENTER]".PadRight(60) -ForegroundColor Yellow
            Write-Host ("Back/Exit: [ESC] or [B]`n").PadRight(60) -ForegroundColor Magenta

            for ($i = 0; $i -lt $MenuItems.Count; $i++) {
                $prefix = if ($i -eq $cursor) { ">>" } else { "  " }
                $checkbox = ""
                $suffix = ""

                if (-not $SingleSelect) {
                    if ($MenuItems[$i].Installed) {
                        if ($MenuItems[$i].Selected) { $checkbox = "[X]"; $suffix = " (Force Reinstall)" }
                        else { $checkbox = "[OK]" }
                    }
                    else {
                        $checkbox = if ($MenuItems[$i].Selected) { "[X]" } else { "[ ]" }
                    }
                }

                $lineText = "$prefix $checkbox $($MenuItems[$i].Display)$suffix".PadRight(70)

                if ($i -eq $cursor) {
                    Write-Host $lineText -ForegroundColor Cyan
                }
                elseif ($MenuItems[$i].Installed -and -not $MenuItems[$i].Selected) {
                    Write-Host $lineText -ForegroundColor Green
                }
                elseif ($MenuItems[$i].Selected -or $SingleSelect) {
                    Write-Host $lineText -ForegroundColor White
                }
                else {
                    Write-Host $lineText -ForegroundColor DarkGray
                }
            }
            $needsRedraw = $false
        }
        Start-Sleep -Milliseconds 50
    }

    [System.Console]::CursorVisible = $true
    Clear-Host; Show-Banner -Color "Cyan"
    return $MenuItems
}

#endregion Helpers

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Core Operations
# ═══════════════════════════════════════════════════════════════════════════════
#region Core Operations

function Assert-Winget {
    if ($DryRun) {
        Write-Log "[DRYRUN] Winget check skipped." -Level INFO
        return
    }
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        Write-Log "Winget is already available." -Level OK
        return
    }

    Write-Log "Winget not found - downloading Microsoft App Installer..." -Level WARN

    Invoke-Failsafe -Name "Install Winget" -Action {
        $progressPreference = 'silentlyContinue'
        $url = "https://github.com/microsoft/winget-cli/releases/latest/download/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.msixbundle"
        $output = "$env:TEMP\winget.msixbundle"
        Invoke-WebRequest -Uri $url -OutFile $output -UseBasicParsing
        Add-AppxPackage -Path $output
        Remove-Item $output -Force

        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
        [System.Environment]::GetEnvironmentVariable("Path", "User")
    }
}

function Install-StandardApp {
    param(
        [Parameter(Mandatory)][string]$AppId,
        [string]$DisplayName = $AppId
    )

    if ($DryRun) {
        Write-Log "[DRYRUN] Would install: $DisplayName ($AppId)" -Level INFO
        Write-Host "  [DRYRUN] Simulating install of $DisplayName..." -ForegroundColor Yellow
        Start-Sleep -Seconds 1
        Write-Log "[DRYRUN] $DisplayName - simulated OK." -Level OK
        return $true
    }

    # Validate that the package ID exists in winget
    $idValid = $true
    try {
        $searchCheck = winget show --id $AppId -e --accept-source-agreements 2>&1 | Out-String
        if ($searchCheck -match "No package found|did not yield any results|0x8a150014") {
            $idValid = $false
        }
    }
    catch {
        $idValid = $false
    }

    # If ID is valid, install normally
    if ($idValid) {
        return Invoke-Failsafe -Name "Install $DisplayName ($AppId)" -Action {
            $result = winget install --id $AppId -e `
                --accept-package-agreements `
                --accept-source-agreements `
                --silent 2>&1

            if ($LASTEXITCODE -ne 0 -and $result -notmatch "already installed|No applicable update") {
                throw "winget exited with code $LASTEXITCODE. Output: $result"
            }
        }
    }

    # ID is invalid - attempt fuzzy search by display name
    Write-Log "Package ID '$AppId' not found in winget. Searching for '$DisplayName'..." -Level WARN

    $fallbackId = $null
    try {
        $raw = winget search $DisplayName --accept-source-agreements 2>&1 | Out-String
        $lines = $raw -split "`n" | Where-Object { $_ -match '\S+\.\S+' -and $_ -notmatch '^-|^Name\s' }

        if ($lines.Count -eq 0) {
            Write-Log "No alternatives found for '$DisplayName'. Skipping." -Level ERROR
            return $false
        }

        $foundApps = @()
        foreach ($line in ($lines | Select-Object -First 5)) {
            $parts = ($line.Trim() -split '\s{2,}') | Where-Object { $_ -ne '' }
            if ($parts.Count -ge 2) {
                $foundApps += [pscustomobject]@{
                    Name    = $parts[0]
                    Id      = $parts[1]
                    Version = if ($parts.Count -ge 3) { $parts[2] } else { "?" }
                }
            }
        }

        if ($foundApps.Count -eq 0) {
            Write-Log "Could not parse search results for '$DisplayName'. Skipping." -Level ERROR
            return $false
        }

        # Show the user the alternatives
        Write-Host "`n+------------------------------------------------------------+" -ForegroundColor Yellow
        Write-Host "|  PACKAGE ID CHANGED - '$AppId' no longer exists" -ForegroundColor Yellow
        Write-Host "|  Closest matches for '$DisplayName':" -ForegroundColor Yellow
        Write-Host "+------------------------------------------------------------+" -ForegroundColor Yellow

        for ($i = 0; $i -lt $foundApps.Count; $i++) {
            $entry = "  [$($i+1)] $($foundApps[$i].Name)  ->  $($foundApps[$i].Id)  (v$($foundApps[$i].Version))"
            Write-Host ("| " + $entry.PadRight(59) + "|") -ForegroundColor White
        }

        Write-Host ("|  [S] Skip this app".PadRight(60) + "|") -ForegroundColor DarkGray
        Write-Host "+------------------------------------------------------------+" -ForegroundColor Yellow

        Write-Host "Pick a number (1-$($foundApps.Count)) or [S] to skip: " -NoNewline -ForegroundColor Cyan

        while ($true) {
            $pick = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
            if ($pick -eq 'S') {
                Write-Host "S" -ForegroundColor Red
                Write-Log "User skipped fallback for '$DisplayName'." -Level WARN
                return $false
            }
            $num = 0
            if ([int]::TryParse($pick, [ref]$num) -and $num -ge 1 -and $num -le $foundApps.Count) {
                Write-Host $pick -ForegroundColor Green
                $fallbackId = $foundApps[$num - 1].Id
                Write-Log "User chose fallback: $fallbackId (was: $AppId)" -Level INFO
                break
            }
        }
    }
    catch {
        Write-Log "Fallback search failed for '$DisplayName': $($_.Exception.Message)" -Level ERROR
        return $false
    }

    # Install the fallback package
    if ($fallbackId) {
        return Invoke-Failsafe -Name "Install $DisplayName (fallback: $fallbackId)" -Action {
            $result = winget install --id $fallbackId -e `
                --accept-package-agreements `
                --accept-source-agreements `
                --silent 2>&1

            if ($LASTEXITCODE -ne 0 -and $result -notmatch "already installed|No applicable update") {
                throw "winget exited with code $LASTEXITCODE. Output: $result"
            }
        }
    }
    
    return $false
}

function Install-TightVNC {
    Write-Host "`n+------------------------------------------------------------+" -ForegroundColor Magenta
    Write-Host "|              TightVNC Configuration                        |" -ForegroundColor Magenta
    Write-Host "+------------------------------------------------------------+" -ForegroundColor Magenta
    Write-Host "|  [1] No Password  (open access - home network)           |" -ForegroundColor White
    Write-Host "|  [2] Set Password (max 8 chars - TightVNC limit)         |" -ForegroundColor White
    Write-Host "|  [S] Skip TightVNC                                       |" -ForegroundColor DarkGray
    Write-Host "+------------------------------------------------------------+" -ForegroundColor Magenta

    Write-Host "Choose (1/2/S): " -NoNewline -ForegroundColor Cyan

    $vncMode = $null
    $vncPassword = ""
    while ($true) {
        $pick = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        if ($pick -eq '1') {
            Write-Host "1 - No Password" -ForegroundColor Green
            $vncMode = "NoAuth"
            break
        }
        elseif ($pick -eq '2') {
            Write-Host "2 - Set Password" -ForegroundColor Green
            $vncMode = "Password"
            break
        }
        elseif ($pick -eq 'S') {
            Write-Host "S - Skipped" -ForegroundColor Red
            Write-Log "User skipped TightVNC installation." -Level WARN
            return $false
        }
    }

    if ($vncMode -eq "Password") {
        Write-Host "Note: TightVNC limits passwords to 8 characters." -ForegroundColor Yellow
        $securePass = Read-Host -AsSecureString "Enter VNC password"
        $vncPassword = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto(
            [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($securePass)
        )
        if ([string]::IsNullOrWhiteSpace($vncPassword)) {
            Write-Log "Empty password entered - falling back to No Auth mode." -Level WARN
            $vncMode = "NoAuth"
        }
    }

    if ($DryRun) {
        Write-Log "[DRYRUN] Would install TightVNC: mode=$vncMode, server-only, no tray, file-transfer ON, RDP session, local input blocked." -Level INFO
        Write-Host "  [DRYRUN] Simulating TightVNC install..." -ForegroundColor Yellow
        Start-Sleep -Seconds 1
        Write-Log "[DRYRUN] TightVNC - simulated OK." -Level OK
        return $true
    }

    return Invoke-Failsafe -Name "Install TightVNC ($vncMode)" -Action {
        $overrideParts = @(
            "/quiet"
            "/norestart"
            "ADDLOCAL=Server"
            "SET_USECONTROLAUTHENTICATION=1"
            "VALUE_OF_USECONTROLAUTHENTICATION=0"
            "SET_ACCEPTHTTPCONNECTIONS=1"
            "VALUE_OF_ACCEPTHTTPCONNECTIONS=0"
            "SET_REMOVEWALLPAPER=1"
            "VALUE_OF_REMOVEWALLPAPER=0"
            "SET_ENABLEFILETRANSFERS=1"
            "VALUE_OF_ENABLEFILETRANSFERS=1"
            "SET_CONNECTTOREMOTESESSION=1"
            "VALUE_OF_CONNECTTOREMOTESESSION=1"
            "SET_RUNCONTROLINTERFACE=1"
            "VALUE_OF_RUNCONTROLINTERFACE=0"
            "SET_BLOCKLOCALINPUT=1"
            "VALUE_OF_BLOCKLOCALINPUT=1"
        )

        if ($vncMode -eq "NoAuth") {
            $overrideParts += "SET_USEVNCAUTHENTICATION=1"
            $overrideParts += "VALUE_OF_USEVNCAUTHENTICATION=0"
        }
        else {
            $overrideParts += "SET_USEVNCAUTHENTICATION=1"
            $overrideParts += "VALUE_OF_USEVNCAUTHENTICATION=1"
            $overrideParts += "SET_PASSWORD=1"
            $overrideParts += "VALUE_OF_PASSWORD=$vncPassword"
            $overrideParts += "SET_VIEWONLYPASSWORD=1"
            $overrideParts += "VALUE_OF_VIEWONLYPASSWORD=$vncPassword"
        }

        $vncOverride = $overrideParts -join " "

        winget install --id TightVNC.TightVNC -e `
            --accept-package-agreements `
            --accept-source-agreements `
            --override $vncOverride

        if ($LASTEXITCODE -ne 0) {
            throw "TightVNC winget install exited with code $LASTEXITCODE"
        }

        Write-Log "TightVNC installed: mode=$vncMode, server-only, no tray, file-transfer ON, RDP session, local input blocked." -Level OK
    }
}

function Install-ZeroTier-AutoJoin {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would install ZeroTier One and join network $ZeroTierNetworkId" -Level INFO
        Write-Host "  [DRYRUN] Simulating ZeroTier install + network join..." -ForegroundColor Yellow
        Start-Sleep -Seconds 1
        Write-Log "[DRYRUN] ZeroTier - simulated OK." -Level OK
        return $true
    }

    $installOk = Invoke-Failsafe -Name "Install ZeroTier One" -Action {
        winget install --id ZeroTier.ZeroTierOne -e `
            --accept-package-agreements `
            --accept-source-agreements `
            --silent

        if ($LASTEXITCODE -ne 0) {
            throw "ZeroTier winget install exited with code $LASTEXITCODE"
        }
    }

    if (-not $installOk) { return $false }

    return Invoke-Failsafe -Name "Join ZeroTier Network ($ZeroTierNetworkId)" -Action {
        Write-Log "Waiting 8 seconds for ZeroTier service to initialize..." -Level INFO
        Start-Sleep -Seconds 8

        $ztCliPath = "C:\ProgramData\ZeroTier\One\zerotier-cli.bat"
        if (Test-Path $ztCliPath) {
            $joinOutput = & $ztCliPath join $ZeroTierNetworkId 2>&1
        }
        else {
            $joinOutput = zerotier-cli join $ZeroTierNetworkId 2>&1
        }
        Write-Log "ZeroTier join output: $joinOutput" -Level INFO

        if ($joinOutput -notmatch "200 join OK|already a member") {
            throw "Unexpected join output: $joinOutput"
        }
    }
}

#endregion Core Operations

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Repair & Security Tools
# ═══════════════════════════════════════════════════════════════════════════════
#region Repair Tools

function Set-TemporaryCloudflareDNS {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would set temporary Cloudflare DNS (1.1.1.1 / 1.0.0.1)" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "Set Temporary Cloudflare DNS" -Action {
        $adapter = Get-NetAdapter |
        Where-Object { $_.Status -eq 'Up' -and $_.InterfaceAlias -notmatch 'ZeroTier|Virtual|vEthernet|Loopback' } |
        Select-Object -First 1

        if (-not $adapter) { throw "No active physical network adapter found." }

        Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ServerAddresses ("1.1.1.1", "1.0.0.1")
        Clear-DnsClientCache
        Write-Log "Cloudflare DNS applied to '$($adapter.InterfaceAlias)'. Will revert on menu exit." -Level OK

        $script:TempDnsAdapter = $adapter
    }
}

function Restore-DNS {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would restore DNS to DHCP" -Level INFO
        $script:TempDnsAdapter = $null
        return
    }
    
    if ($script:TempDnsAdapter) {
        Invoke-Failsafe -Name "Revert DNS on $($script:TempDnsAdapter.InterfaceAlias)" -Action {
            Set-DnsClientServerAddress -InterfaceIndex $script:TempDnsAdapter.ifIndex -ResetServerAddresses
            Clear-DnsClientCache
            $script:TempDnsAdapter = $null
        }
    }
}

function Invoke-SFC {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would run SFC /scannow" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "SFC /scannow" -Action {
        sfc /scannow
        if ($LASTEXITCODE -ne 0) {
            Write-Log "SFC reported issues - check CBS.log for details." -Level WARN
        }
    }
}

function Invoke-DISM {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would run DISM /RestoreHealth (Standard)" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "DISM RestoreHealth (Standard)" -Action {
        $env:HTTP_PROXY = ""
        $env:HTTPS_PROXY = ""
        DISM /Online /Cleanup-Image /RestoreHealth
    }
}

function Invoke-DISM-WithProxy {
    $proxyStr = Read-Host "Enter Proxy Address (e.g., http://192.168.1.50:8080 )"

    if ([string]::IsNullOrWhiteSpace($proxyStr)) {
        Write-Log "No proxy entered - skipping DISM with proxy." -Level WARN
        return $false
    }

    if ($DryRun) {
        Write-Log "[DRYRUN] Would run DISM /RestoreHealth via proxy $proxyStr" -Level INFO
        return $true
    }
    
    Invoke-Failsafe -Name "DISM RestoreHealth (Proxy: $proxyStr)" -Action {
        $env:HTTP_PROXY = $proxyStr
        $env:HTTPS_PROXY = $proxyStr
        netsh winhttp set proxy $proxyStr | Out-Null
        Write-Log "System proxy set to $proxyStr" -Level INFO

        DISM /Online /Cleanup-Image /RestoreHealth

        $env:HTTP_PROXY = ""
        $env:HTTPS_PROXY = ""
        netsh winhttp reset proxy | Out-Null
        Write-Log "Proxy settings reset." -Level OK
    }
}

function Invoke-Massgrave {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would fetch and run Massgrave activation script from https://get.activated.win" -Level INFO
        Write-Host "  [DRYRUN] Simulating Massgrave execution..." -ForegroundColor Yellow
        return $true
    }
    
    Invoke-Failsafe -Name "Massgrave Activation Script" -Action {
        Write-Log "Fetching Massgrave script from GitHub..." -Level INFO
        Invoke-RestMethod https://get.activated.win | Invoke-Expression
    }
}

function Invoke-WinUtil {
    if ($DryRun) {
        Write-Log "[DRYRUN] Would fetch and run Chris Titus WinUtil from https://christitus.com/win" -Level INFO
        Write-Host "  [DRYRUN] Simulating WinUtil execution..." -ForegroundColor Yellow
        return $true
    }
    
    Invoke-Failsafe -Name "Chris Titus WinUtil" -Action {
        Write-Log "Fetching WinUtil from christitus.com..." -Level INFO
        Invoke-RestMethod https://christitus.com/win | Invoke-Expression
    }
}

function Invoke-KVRT {
    $desktopPath = [Environment]::GetFolderPath("Desktop")
    $kvrtPath = Join-Path $desktopPath "KVRT.exe"

    if ($DryRun) {
        Write-Log "[DRYRUN] Would download KVRT to $kvrtPath" -Level INFO
        Write-Host "  [DRYRUN] Simulating KVRT download..." -ForegroundColor Yellow
        
        Write-Host "`nLaunch KVRT now? (Y/N): " -NoNewline -ForegroundColor Yellow
        while ($true) {
            $runKey = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
            if ($runKey -eq 'Y') {
                Write-Host "Y" -ForegroundColor Green
                Write-Log "[DRYRUN] Would launch KVRT" -Level INFO
                break
            }
            elseif ($runKey -eq 'N') {
                Write-Host "N" -ForegroundColor Cyan
                Write-Log "[DRYRUN] User chose not to launch KVRT." -Level INFO
                break
            }
        }
        return $true
    }

    $downloaded = Invoke-Failsafe -Name "Download KVRT" -Action {
        Invoke-WebRequest -Uri "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe" `
            -OutFile $kvrtPath -UseBasicParsing
        Write-Log "KVRT saved to $kvrtPath" -Level OK
    }

    if (-not $downloaded) { return $false }

    Write-Host "`nLaunch KVRT now? (Y/N): " -NoNewline -ForegroundColor Yellow
    while ($true) {
        $runKey = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        if ($runKey -eq 'Y') {
            Write-Host "Y" -ForegroundColor Green
            Invoke-Failsafe -Name "Launch KVRT" -Action { Start-Process $kvrtPath }
            break
        }
        elseif ($runKey -eq 'N') {
            Write-Host "N" -ForegroundColor Cyan
            Write-Log "User chose not to launch KVRT." -Level INFO
            break
        }
    }
}

#endregion Repair Tools

# ═══════════════════════════════════════════════════════════════════════════════
# REGION: Main Application Loop
# ═══════════════════════════════════════════════════════════════════════════════
#region Main

Write-Log ("=" * 60) -Level INFO
Write-Log "OMNITX Setup v3.0.2 - Session started." -Level INFO
if ($DryRun) { Write-Log "DRY RUN MODE ENABLED - No changes will be made" -Level WARN }
Write-Log ("=" * 60) -Level INFO

while ($true) {
    $mainMenuItems = @(
        [pscustomobject]@{ Display = "1. Install OMNITX Setup (Apps & Tools)"; Id = "Apps"; Selected = $false }
        [pscustomobject]@{ Display = "2. Fix & Repair Windows"; Id = "Fix"; Selected = $false }
        [pscustomobject]@{ Display = "3. Exit"; Id = "Exit"; Selected = $false }
    )

    $mainChoice = Show-Menu -Title "OMNITX Main Menu" -MenuItems $mainMenuItems -SingleSelect

    if ($mainChoice -eq "ESC" -or $mainChoice -eq "BACK") { break }

    $selectedMain = ($mainChoice | Where-Object { $_.Selected }).Id

    if ($selectedMain -eq "Exit") {
        Write-Log "User exited the script." -Level INFO
        Write-Host "`nExiting OMNITX Setup. Goodbye!" -ForegroundColor Green
        break
    }

    # PAGE 1 - APP INSTALLER (One-by-One Flow)
    if ($selectedMain -eq "Apps") {

        Assert-Winget

        $successCount = 0
        $failCount = 0
        $skippedCount = 0
        $aborted = $false

        Write-Host "`n+------------------------------------------------------------+" -ForegroundColor Cyan
        Write-Host "|          APP INSTALLER - One by One                        |" -ForegroundColor Cyan
        Write-Host "|  [Y] Install   [N] Skip   [ESC] Abort remaining            |" -ForegroundColor Cyan
        Write-Host "+------------------------------------------------------------+`n" -ForegroundColor Cyan

        for ($idx = 0; $idx -lt $AppCatalog.Count; $idx++) {
            $app = $AppCatalog[$idx]

            if ($aborted) { break }

            $num = $idx + 1
            $total = $AppCatalog.Count
            $tag = switch ($app.Type) {
                "VNC" { "  [VNC - will configure]" }
                "ZeroTier" { "  [Auto-join network]" }
                default { "" }
            }

            Write-Host ("-" * 60) -ForegroundColor DarkGray
            Write-Host "  [$num/$total]  $($app.Display)$tag" -ForegroundColor White
            Write-Host "          Package: $($app.Id)" -ForegroundColor DarkGray
            Write-Host "  Install? [Y/N/ESC]: " -NoNewline -ForegroundColor Yellow

            $decision = $null
            while ($true) {
                $k = [System.Console]::ReadKey($true)
                if ($k.Key -eq 'Escape') {
                    Write-Host "ESC - Aborting remaining apps." -ForegroundColor Red
                    Write-Log "User pressed ESC at app $num/$total ($($app.Display)). Aborting remaining." -Level WARN
                    $aborted = $true
                    $decision = "SKIP"
                    break
                }
                $ch = $k.KeyChar.ToString().ToUpper()
                if ($ch -eq 'Y') {
                    Write-Host "Y" -ForegroundColor Green
                    $decision = "INSTALL"
                    break
                }
                elseif ($ch -eq 'N') {
                    Write-Host "N - Skipped" -ForegroundColor DarkGray
                    $decision = "SKIP"
                    break
                }
            }

            if ($decision -eq "SKIP") {
                $skippedCount++
                Write-Log "Skipped: $($app.Display)" -Level INFO
                continue
            }

            switch ($app.Type) {
                "Standard" {
                    $ok = Install-StandardApp -AppId $app.Id -DisplayName $app.Display
                    if ($ok) { $successCount++ } else { $failCount++ }
                }
                "VNC" {
                    $ok = Install-TightVNC
                    if ($ok -eq $false) { $skippedCount++ }
                    else { $successCount++ }
                }
                "ZeroTier" {
                    $ok = Install-ZeroTier-AutoJoin
                    if ($ok) { $successCount++ } else { $failCount++ }
                }
            }

            Write-Host ""
        }

        if (-not $aborted) {
            Write-Host ("-" * 60) -ForegroundColor DarkGray
            Write-Host "`n  Install custom winget packages? [Y/N]: " -NoNewline -ForegroundColor Magenta
            $doCustom = $false
            while ($true) {
                $ck = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
                if ($ck -eq 'Y') { Write-Host "Y`n" -ForegroundColor Green; $doCustom = $true; break }
                if ($ck -eq 'N') { Write-Host "N`n" -ForegroundColor DarkGray; break }
            }

            if ($doCustom) {
                Write-Host "--- Custom Application Installation ---`n" -ForegroundColor Cyan
                $installMore = $true
                while ($installMore) {
                    $customApp = Read-Host "Enter the winget package ID (e.g., Mozilla.Firefox)"
                    if (![string]::IsNullOrWhiteSpace($customApp)) {
                        $ok = Install-StandardApp -AppId $customApp -DisplayName $customApp
                        if ($ok) { $successCount++ } else { $failCount++ }
                    }
                    Write-Host "`nInstall another? (Y/N): " -NoNewline -ForegroundColor Yellow
                    while ($true) {
                        $ck2 = [System.Console]::ReadKey($true).KeyChar.ToString().ToUpper()
                        if ($ck2 -eq 'Y') { Write-Host "Y`n" -ForegroundColor Cyan; break }
                        if ($ck2 -eq 'N') { Write-Host "N`n" -ForegroundColor Cyan; $installMore = $false; break }
                    }
                }
            }
        }

        Write-Host "`n+------------------------------------------------------------+" -ForegroundColor Cyan
        Write-Host "|                  INSTALLATION REPORT                       |" -ForegroundColor Cyan
        Write-Host "+------------------------------------------------------------+" -ForegroundColor Cyan
        Write-Host ("|  Succeeded : $successCount".PadRight(60) + "|") -ForegroundColor Green
        Write-Host ("|  Skipped   : $skippedCount".PadRight(60) + "|") -ForegroundColor DarkGray
        Write-Host ("|  Failed    : $failCount".PadRight(60) + "|") -ForegroundColor $(if ($failCount -gt 0) { "Red" } else { "Green" })
        Write-Host ("|  Log File  : $LogFile".PadRight(60) + "|") -ForegroundColor Yellow
        if ($DryRun) {
            Write-Host ("|  Mode      : DRY RUN (no changes made)".PadRight(60) + "|") -ForegroundColor Yellow
        }
        Write-Host "+------------------------------------------------------------+`n" -ForegroundColor Cyan

        Write-Log "Installation complete. $successCount OK, $skippedCount skipped, $failCount failed." -Level $(if ($failCount -gt 0) { "WARN" } else { "OK" })

        Write-Host "Press any key to return to Main Menu..." -ForegroundColor Yellow
        $null = [System.Console]::ReadKey($true)
    }

    # PAGE 2 - FIX & REPAIR WINDOWS
    elseif ($selectedMain -eq "Fix") {
        $script:TempDnsAdapter = $null

        while ($true) {
            $fixItems = @(
                [pscustomobject]@{ Display = "Temporarily apply Cloudflare DNS (1.1.1.1)"; Id = "CF_DNS"; Selected = $false }
                [pscustomobject]@{ Display = "SFC /Scannow (System File Checker)"; Id = "SFC"; Selected = $false }
                [pscustomobject]@{ Display = "DISM /RestoreHealth (Standard, No Proxy)"; Id = "DISM"; Selected = $false }
                [pscustomobject]@{ Display = "DISM /RestoreHealth (Custom Proxy)"; Id = "DISM_PROXY"; Selected = $false }
                [pscustomobject]@{ Display = "Run Massgrave Activation Script"; Id = "MASSGRAVE"; Selected = $false }
                [pscustomobject]@{ Display = "Run Chris Titus WinUtil (Tweaks & Debloat)"; Id = "WINUTIL"; Selected = $false }
                [pscustomobject]@{ Display = "Download & Run KVRT (Malware Scan)"; Id = "KVRT"; Selected = $false }
            )

            $fixChoice = Show-Menu -Title "Windows Repair & Security (Enter to run action)" -MenuItems $fixItems -SingleSelect

            if ($fixChoice -eq "ESC" -or $fixChoice -eq "BACK") {
                Restore-DNS
                break
            }

            $selectedAction = ($fixChoice | Where-Object { $_.Selected }).Id

            switch ($selectedAction) {
                "CF_DNS" { Set-TemporaryCloudflareDNS }
                "SFC" { Invoke-SFC }
                "DISM" { Invoke-DISM }
                "DISM_PROXY" { Invoke-DISM-WithProxy }
                "MASSGRAVE" { Invoke-Massgrave }
                "WINUTIL" { Invoke-WinUtil }
                "KVRT" { Invoke-KVRT }
            }

            Write-Host "`nTask complete. Press any key to return to the Repair menu..." -ForegroundColor Yellow
            $null = [System.Console]::ReadKey($true)
        }
    }
}

Write-Log "OMNITX Setup session ended." -Level INFO
Write-Host "`nLog saved to: $LogFile`n" -ForegroundColor DarkGray

#endregion Main